# Copy to .env.prod and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
OPENAI_API_KEY=

# The public address, without https://. No domain yet? Use your server's IP with dots as dashes + .sslip.io,
# e.g. IP 203.0.113.7 -> 203-0-113-7.sslip.io (free, and Caddy gets an HTTPS certificate for it).
DOMAIN=docmind.example.com
NEXT_PUBLIC_SITE_URL=https://docmind.example.com
# Web and API share this one address (Caddy routes /api/v1 to the API), so cookies and CORS just work.
NEXT_PUBLIC_API_URL=https://docmind.example.com/api/v1
WEB_ORIGIN=https://docmind.example.com

# true when a reverse proxy sits in front of the API (Caddy does)
TRUST_PROXY=true

# Chat models (OpenAI). Leave LLM_BASE_URL empty for OpenAI.
LLM_MODEL=gpt-5
LLM_FAST_MODEL=gpt-5-mini
# LLM_JUDGE_MODEL=gpt-5
# RERANK_ENABLED=false
# WITH_LIBREOFFICE=true      # only for legacy .doc files
